{
  "name": "sticky-notes",
  "version": "1.0.0",
  "description": "Note adesive desktop per Windows 11 con Markdown, scadenze, tag e vista calendario",
  "author": {
    "name": "Maurizio Tolomeo",
    "email": "maurizio.tolomeo@outlook.it",
    "site": "https://mauriziotolomeo.it"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "set ENVIRONMENT=development && electron-vite dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "package": "pnpm build && electron-builder --win nsis",
    "electron:install": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "it.maurizio.stickynotes",
    "productName": "Note adesive",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
